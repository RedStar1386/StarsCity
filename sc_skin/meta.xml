<meta>
    <info
        author="StarsCity"
        version="4.0.0"
        name="Automatic Custom Skins"
        description="Automatic ped, vehicle and weapon model replacement system"
        type="script"
    />

    <!-- pathListDir/pathIsFile require r22470; glob file patterns require r22430. -->
    <min_mta_version client="1.6.0-9.22470.0" server="1.6.0-9.22470.0" />

    <script src="config.lua" type="shared" />
    <script src="server.lua" type="server" />
    <script src="client.lua" type="client" />

    <!-- PED: <modelID>.dff / <modelID>.txd / optional <modelID>.col -->
    <file src="ped_skins/*.dff" />
    <file src="ped_skins/*.txd" />
    <file src="ped_skins/*.col" />

    <!-- VEHICLE: <modelID>.dff / <modelID>.txd / optional <modelID>.col -->
    <file src="vehicle_skins/*.dff" />
    <file src="vehicle_skins/*.txd" />
    <file src="vehicle_skins/*.col" />

    <!-- WEAPON: use the GTA object model ID, not the weapon ID. -->
    <file src="weapon_skins/*.dff" />
    <file src="weapon_skins/*.txd" />

    <!-- Backwards-compatible folder name from the original resource. -->
    <file src="gun_skins/*.dff" />
    <file src="gun_skins/*.txd" />
</meta>
